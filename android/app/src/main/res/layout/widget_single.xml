<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_single_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_single_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_quick_tile" />

    <TextView
        android:id="@+id/widget_single_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Shortcut"
        android:textColor="#0F172A"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
