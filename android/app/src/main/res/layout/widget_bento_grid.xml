<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="REDIRECT"
            android:textColor="#0F172A"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top Shortcuts"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 2x2 Bento Grid Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Slot 0 -->
        <LinearLayout
            android:id="@+id/widget_slot_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_item_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/widget_slot_0_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_quick_tile" />

            <TextView
                android:id="@+id/widget_slot_0_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Slot 1"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slot 1 -->
        <LinearLayout
            android:id="@+id/widget_slot_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_item_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/widget_slot_1_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_quick_tile" />

            <TextView
                android:id="@+id/widget_slot_1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Slot 2"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2x2 Bento Grid Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Slot 2 -->
        <LinearLayout
            android:id="@+id/widget_slot_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_item_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/widget_slot_2_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_quick_tile" />

            <TextView
                android:id="@+id/widget_slot_2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Slot 3"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slot 3 -->
        <LinearLayout
            android:id="@+id/widget_slot_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_item_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/widget_slot_3_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_quick_tile" />

            <TextView
                android:id="@+id/widget_slot_3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Slot 4"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
